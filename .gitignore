# Local station inputs; commit only the supplied synthetic example by default.
input/*
!input/test/
input/test/*
!input/test/measurements.csv
!input/test/daily_stage.csv

# Results are local. Keep the empty example destination in Git.
output/**
!output/test/
!output/test/.gitkeep

# Python environments, caches and optional saved forests.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
*.joblib
*.log
.env
.env.*
.DS_Store
Thumbs.db
